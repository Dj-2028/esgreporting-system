NODE_ENV=development
PORT=5000
# Must be a replica set (transactions). Docker: docker compose up mongo
# Without Docker: npm run dev:db
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xt9ijyi.mongodb.net/esg?retryWrites=true&w=majority
# 64+ random chars each: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-too-change-me-too-change-me-too-change-me-too-1234
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false

STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

MAX_FILE_MB=10
MAX_FILES_PER_RECORD=10

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=ESG Platform <no-reply@esg.local>

BCRYPT_COST=12
LOG_LEVEL=info
